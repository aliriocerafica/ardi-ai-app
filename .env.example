# Copy to .env and fill in real values. Never commit .env.
# These names must stay server-only. Do not add a NEXT_PUBLIC_ prefix.

# Pooled connection for the Next.js app (hostname includes -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"

# Direct connection for Prisma CLI (migrations and introspection)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"

# Google AI Studio key for Gemini. Server-only. Do not add a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
